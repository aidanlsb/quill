#!/usr/bin/env bash
# Doctor and drive the Quill macOS app. See .cursor/skills/verify-quill/SKILL.md.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

mode="drive"
bin=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    doctor)
      mode="doctor"
      shift
      ;;
    --bin)
      bin="${2:-}"
      if [[ -z "$bin" ]]; then
        echo "verify-quill: --bin needs a path" >&2
        exit 2
      fi
      shift 2
      ;;
    *)
      echo "usage: Scripts/verify-quill [doctor] [--bin PATH]" >&2
      exit 2
      ;;
  esac
done

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "verify-quill: Quill is an AppKit app. This host ($(uname -s)) cannot launch it." >&2
  echo "verify-quill: run Scripts/verify-quill on macOS. The macos CI job is the harness." >&2
  exit 1
fi

if ! command -v swift >/dev/null 2>&1; then
  echo "verify-quill: swift is not on PATH" >&2
  exit 1
fi

swift_line="$(swift --version | head -n 1)"
echo "verify-quill: $swift_line"

if [[ -z "$bin" ]]; then
  bin="$(swift build -c release --product Quill -Xswiftc -strict-concurrency=complete --show-bin-path)/Quill"
fi

if [[ ! -x "$bin" ]]; then
  echo "verify-quill: binary is not executable: $bin" >&2
  exit 1
fi

echo "verify-quill: binary $bin"

if [[ "$mode" == "doctor" ]]; then
  exit 0
fi

mkdir -p "$root/artifacts/verify-quill"
log="$root/artifacts/verify-quill/smoke.log"
: > "$log"

QUILL_SMOKE=1 "$bin" >"$log" 2>&1 &
pid=$!
status=0
finished=0
i=0
# AppSmoke arms its own watchdog and exits 2 with a diagnostic after 20s.
while [[ "$i" -lt 30 ]]; do
  if ! kill -0 "$pid" 2>/dev/null; then
    set +e
    wait "$pid"
    status=$?
    set -e
    finished=1
    break
  fi
  sleep 1
  i=$((i + 1))
done

if [[ "$finished" -eq 0 ]]; then
  echo "verify-quill: smoke still running after 30s; killing pid $pid" >&2
  kill "$pid" 2>/dev/null || true
  sleep 1
  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  exit 1
fi

if [[ "$status" -ne 0 ]]; then
  echo "verify-quill: smoke failed (status $status). Log: $log" >&2
  cat "$log" >&2 || true
  exit "$status"
fi

if ! grep -F -q "quill smoke passed" "$log"; then
  echo "verify-quill: smoke exited 0 without 'quill smoke passed'. Log: $log" >&2
  cat "$log" >&2 || true
  exit 1
fi

if grep -F -q "FAIL " "$log"; then
  echo "verify-quill: smoke log contains FAIL. Log: $log" >&2
  cat "$log" >&2 || true
  exit 1
fi

echo "verify-quill: quill smoke passed"
echo "verify-quill: evidence $log"

# Separate process from the smoke. Records launch and editing timings.
# The app's own probe exits; this kill is only if that probe wedges.
perf_log="$root/artifacts/verify-quill/perf.log"
: > "$perf_log"
QUILL_PERF=1 "$bin" >"$perf_log" 2>&1 &
perf_pid=$!
perf_status=0
perf_done=0
i=0
while [[ "$i" -lt 90 ]]; do
  if ! kill -0 "$perf_pid" 2>/dev/null; then
    set +e
    wait "$perf_pid"
    perf_status=$?
    set -e
    perf_done=1
    break
  fi
  sleep 1
  i=$((i + 1))
done
if [[ "$perf_done" -eq 0 ]]; then
  echo "verify-quill: perf still running after 90s; killing pid $perf_pid" >&2
  kill "$perf_pid" 2>/dev/null || true
  sleep 1
  kill -9 "$perf_pid" 2>/dev/null || true
  wait "$perf_pid" 2>/dev/null || true
  exit 1
fi
if [[ "$perf_status" -ne 0 ]]; then
  echo "verify-quill: perf failed (status $perf_status). Log: $perf_log" >&2
  cat "$perf_log" >&2 || true
  exit "$perf_status"
fi
if ! grep -F -q "quill perf done" "$perf_log"; then
  echo "verify-quill: perf exited without 'quill perf done'. Log: $perf_log" >&2
  cat "$perf_log" >&2 || true
  exit 1
fi
echo "verify-quill: perf"
grep -F "quill perf " "$perf_log" || true
echo "verify-quill: perf evidence $perf_log"

# Installed-style `quill` against a bundle built from this binary.
# Asserts an onscreen document window via CGWindowList (not Accessibility).
check_cli_windows() {
  local bin="$1"
  local parent dest app_bin helper work note
  parent="$(mktemp -d "${TMPDIR:-/tmp}/quill-cli.XXXXXX")"
  dest="$parent/Quill.app"
  app_bin="$dest/Contents/MacOS/Quill"
  helper="$parent/onscreen-window"
  work="$parent/work"
  bundle_pids() {
    ps -ax -o pid=,command= | awk -v needle="$app_bin" 'index($0, needle) { print $1 }'
  }
  cleanup_cli() {
    local pid
    local pids
    pids="$(bundle_pids)"
    for pid in $pids; do
      kill "$pid" 2>/dev/null || true
    done
    sleep 0.3
    pids="$(bundle_pids)"
    for pid in $pids; do
      kill -9 "$pid" 2>/dev/null || true
    done
    rm -rf "$parent"
  }
  trap cleanup_cli EXIT

  mkdir -p "$dest/Contents/MacOS" "$dest/Contents/Resources" "$work/notes"
  cp "$bin" "$app_bin"
  cp "$root/Sources/Quill/Info.plist" "$dest/Contents/Info.plist"
  chmod +x "$app_bin"
  xattr -cr "$dest" 2>/dev/null || true
  if command -v codesign >/dev/null 2>&1; then
    codesign --force --sign - "$dest"
  fi
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  if [[ -x "$lsregister" ]]; then
    "$lsregister" -f "$dest" >/dev/null 2>&1 || true
  fi
  swiftc -O -o "$helper" "$root/Scripts/onscreen-window.swift"

  note="$work/README.md"
  printf 'alpha\nbeta\n' > "$note"
  mkdir -p "$work/notes"

  quit_bundle() {
    local pid
    local pids
    pids="$(bundle_pids)"
    for pid in $pids; do
      kill "$pid" 2>/dev/null || true
    done
    local i=0
    while [[ "$i" -lt 20 ]]; do
      pids="$(bundle_pids)"
      if [[ -z "$pids" ]]; then
        return 0
      fi
      sleep 0.25
      i=$((i + 1))
    done
    for pid in $pids; do
      kill -9 "$pid" 2>/dev/null || true
    done
    sleep 0.3
  }

  wait_for_window() {
    local i=0 pid pids
    while [[ "$i" -lt 30 ]]; do
      pids="$(bundle_pids)"
      for pid in $pids; do
        if "$helper" "$pid"; then
          echo "$pid"
          return 0
        fi
      done
      sleep 0.5
      i=$((i + 1))
    done
    return 1
  }

  fail_windows() {
    local label="$1"
    echo "verify-quill: no onscreen window for $label" >&2
    "$helper" --list >&2 || true
    ps -ax -o pid=,command= | awk 'index($0, "Quill") { print }' >&2 || true
    return 1
  }

  run_cold() {
    local label="$1"
    shift
    quit_bundle
    echo "verify-quill: cli cold $label"
    if ! QUILL_APP="$dest" "$root/Scripts/quill" "$@"; then
      echo "verify-quill: launcher failed for cold $label" >&2
      return 1
    fi
    local pid
    if ! pid="$(wait_for_window)"; then
      fail_windows "cold $label"
      return 1
    fi
    echo "verify-quill: cli cold $label window pid $pid"
  }

  run_warm() {
    local label="$1"
    shift
    local before
    before="$(bundle_pids | head -n 1 || true)"
    echo "verify-quill: cli warm $label"
    if ! QUILL_APP="$dest" "$root/Scripts/quill" "$@"; then
      echo "verify-quill: launcher failed for warm $label" >&2
      return 1
    fi
    local pid
    if ! pid="$(wait_for_window)"; then
      fail_windows "warm $label"
      return 1
    fi
    if [[ -n "$before" ]] && kill -0 "$before" 2>/dev/null; then
      if ! "$helper" "$before"; then
        echo "verify-quill: warm $label hid pid $before" >&2
        "$helper" --list >&2 || true
        return 1
      fi
    fi
    echo "verify-quill: cli warm $label window pid $pid"
  }

  run_wait() {
    local label="$1"
    local need="$2"
    local launcher pid pids count ready i
    echo "verify-quill: cli $label"
    QUILL_APP="$dest" "$root/Scripts/quill" --wait "$note" &
    launcher=$!
    i=0
    while [[ "$i" -lt 30 ]]; do
      pids="$(bundle_pids)"
      count=0
      ready=0
      for pid in $pids; do
        count=$((count + 1))
        if "$helper" "$pid"; then
          ready=$((ready + 1))
        fi
      done
      if [[ "$count" -ge "$need" && "$ready" -ge "$need" ]]; then
        echo "verify-quill: cli $label windows $ready"
        quit_bundle
        wait "$launcher" 2>/dev/null || true
        return 0
      fi
      sleep 0.5
      i=$((i + 1))
    done
    kill "$launcher" 2>/dev/null || true
    fail_windows "$label"
    quit_bundle
    wait "$launcher" 2>/dev/null || true
    return 1
  }

  local status=0
  run_cold "no-args" || status=1
  if [[ "$status" -eq 0 ]]; then run_cold "file" "$note" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_cold "dir" "$work/notes" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_cold "plus" +4 "$note" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_cold "line-col" "$note:2:1" || status=1; fi
  if [[ "$status" -eq 0 ]]; then
    quit_bundle
    run_wait "cold --wait" 1 || status=1
  fi
  if [[ "$status" -eq 0 ]]; then
    quit_bundle
    run_cold "warm-base" || status=1
  fi
  if [[ "$status" -eq 0 ]]; then run_warm "file" "$note" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_warm "dir" "$work/notes" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_warm "plus" +4 "$note" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_warm "line-col" "$note:2:1" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_warm "no-args" || status=1; fi
  if [[ "$status" -eq 0 ]]; then run_wait "warm --wait" 2 || status=1; fi

  trap - EXIT
  cleanup_cli
  if [[ "$status" -ne 0 ]]; then
    exit 1
  fi
  echo "verify-quill: cli windows passed"
}

check_cli_windows "$bin"
