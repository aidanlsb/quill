#!/usr/bin/env bash
# Launch Quill with zero or more files/directories.
# Usage:
#   quill
#   quill path/to/note.md
#   quill .
#   quill --wait new-note.md
set -euo pipefail

resolve_app() {
  local here
  here="$(cd "$(dirname "$0")" && pwd)"
  if [[ -d "/Applications/Quill.app" ]]; then
    echo "/Applications/Quill.app"
  elif [[ -d "$here/../dist/Quill.app" ]]; then
    echo "$here/../dist/Quill.app"
  elif [[ -d "$here/../.build/Quill.app" ]]; then
    echo "$here/../.build/Quill.app"
  else
    echo "Quill"
  fi
}

APP="$(resolve_app)"
wait_flag=()
if [[ "${1:-}" == "--wait" ]]; then
  wait_flag=(-W -n)
  shift
fi
if [[ $# -eq 0 ]]; then
  if [[ "$APP" == "Quill" ]]; then
    open "${wait_flag[@]}" -a Quill
  else
    open "${wait_flag[@]}" -a "$APP"
  fi
  exit 0
fi

# Expand relative paths and create files that do not exist yet.
args=()
for arg in "$@"; do
  if [[ -e "$arg" ]]; then
    args+=("$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")")
  else
    mkdir -p "$(dirname "$arg")"
    : > "$arg"
    args+=("$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")")
  fi
done

if [[ "$APP" == "Quill" ]]; then
  open "${wait_flag[@]}" -a Quill -- "${args[@]}"
else
  open "${wait_flag[@]}" -a "$APP" -- "${args[@]}"
fi
