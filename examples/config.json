{
  "leader": " ",
  "leaderMaps": {
    "sf": "findFiles",
    "sg": "liveGrep"
  },
  "shellCommands": {
    "d": "rvn daily"
  },
  "columnWidth": 70,
  "fontSize": 16,
  "font": "",
  "shiftWidth": 2,
  "lsp": {
    "servers": [
      {
        "name": "marksman",
        "command": "marksman",
        "arguments": ["server"],
        "extensions": [".md", ".markdown"],
        "languages": ["markdown"],
        "rootMarkers": [".git", ".marksman.toml"],
        "env": {}
      },
      {
        "name": "rvn",
        "command": "rvn",
        "arguments": ["lsp"],
        "extensions": [".md", ".markdown"],
        "languages": ["markdown"],
        "rootMarkers": [".git"],
        "env": {}
      }
    ]
  }
}
